# Anthropic API key for Claude synthesis node (Node 5)
# Get yours at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Ollama local LLM server — default port, no auth required
OLLAMA_BASE_URL=http://localhost:11434

# ChromaDB vector store persistence path (relative to backend/)
CHROMA_DB_PATH=../chroma_db

# Knowledge base text files path (relative to backend/)
KNOWLEDGE_BASE_PATH=../knowledge_base

# NewsAPI free-tier key — 100 requests/day
# Register at: https://newsapi.org
NEWSAPI_KEY=your-newsapi-key-here

# SQLite database paths
DATABASE_URL=sqlite:///./startup_risk.db
CHECKPOINT_DB_PATH=./checkpoints.db