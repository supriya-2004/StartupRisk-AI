# ═══════════════════════════════════════════════════════════════
#  StartupRisk AI v2  —  backend/.gitignore
#  Python · FastAPI · LangGraph · Ollama · RAG pipeline
# ═══════════════════════════════════════════════════════════════


#  Secrets (never commit real keys) 
.env
!.env.example


#  Python Bytecode 
__pycache__/
*.pyc
*.pyo
*.pyd
*.pycache


#  Virtual Environment 
venv/
.venv/
env/


#  ChromaDB Persistence 
# Generated by rag/indexer.py on first startup (~30 sec to rebuild)
# Contains embedded vectors of knowledge_base/ text files
chroma_db/
*.chroma
chroma.sqlite3


#  LangGraph SQLite Checkpointer 
# Stores per-request graph state — regenerated each run
checkpoints.db
checkpoints.db-shm
checkpoints.db-wal


#  Application Database 
# Report history and query records — local dev data only
startup_risk.db
startup_risk.db-shm
startup_risk.db-wal
*.sqlite
*.sqlite3
*.db


#  HuggingFace Model Cache 
# FinBERT (~440 MB) and all-MiniLM-L6-v2 (~80 MB) are downloaded
# automatically on first run via transformers / sentence-transformers
.cache/
huggingface_cache/
model_cache/
transformers_cache/


#  Pytest & Coverage 
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.cover
.hypothesis/
test-results/
junit.xml


#  Type Checking 
.mypy_cache/
.ruff_cache/
.pytype/


#  Build / Distribution 
dist/
build/
*.egg-info/
*.egg
*.whl


#  Logs 
logs/
*.log


#  IDE 
.vscode/
.idea/
*.swp
*~